{
  "name": "simply-reader",
  "productName": "Simply Reader",
  "version": "1.0.2",
  "description": "A desktop e-book reader for EPUB, MOBI, AZW3, FB2 and CBZ",
  "main": "src/main.js",
  "desktopName": "simply-reader.desktop",
  "author": "drago",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb rpm"
  },
  "build": {
    "appId": "com.simplyreader.app",
    "productName": "Simply Reader",
    "files": [
      "src/**/*",
      "vendor/foliate-js/**/*",
      "!vendor/foliate-js/**/*.md",
      "!vendor/foliate-js/**/*.map",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "SimplyReader-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "simply-reader",
      "syncDesktopName": true,
      "icon": "src/renderer/icon.png",
      "category": "Office",
      "synopsis": "A calm, fast e-book reader",
      "description": "Simply Reader opens EPUB, MOBI, AZW3, FB2, CBZ and PDF books, keeps your library in one place and remembers where you stopped in every book.",
      "maintainer": "Dragos B <20815213+unkindee@users.noreply.github.com>",
      "mimeTypes": [
        "application/epub+zip",
        "application/x-mobipocket-ebook",
        "application/vnd.amazon.mobi8-ebook",
        "application/x-fictionbook+xml",
        "application/vnd.comicbook+zip"
      ],
      "desktop": {
        "entry": {
          "Keywords": "ebook;e-book;epub;mobi;kindle;reader;books;library;"
        }
      }
    },
    "appImage": {
      "artifactName": "SimplyReader-${version}-${arch}.AppImage"
    },
    "deb": {
      "packageCategory": "text",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "role": "Viewer"
      },
      {
        "ext": "mobi",
        "name": "MOBI Book",
        "role": "Viewer"
      },
      {
        "ext": "azw3",
        "name": "Kindle Book",
        "role": "Viewer"
      },
      {
        "ext": "azw",
        "name": "Kindle Book",
        "role": "Viewer"
      },
      {
        "ext": "fb2",
        "name": "FictionBook",
        "role": "Viewer"
      },
      {
        "ext": "cbz",
        "name": "Comic Book",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
